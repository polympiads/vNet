[Unit]
Description=vNet conductor
After=network-online.target
Wants=network-online.target

[Service]
# Written by tools/vnet-roster.py: CONDUCTOR_PORT, VNET_AUTH_FILE, TLS files.
EnvironmentFile=/etc/vnet/conductor.env
ExecStart=/usr/local/bin/conductor
Restart=always
RestartSec=2
# SIGUSR1 writes the state dump at once.
ExecReload=/bin/kill -USR1 $MAINPID

[Install]
WantedBy=multi-user.target
